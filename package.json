{
  "name": "ascci",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Convertisseur local d’images en art ASCII",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "test": "node --test",
    "test:desktop": "electron desktop/smoke.cjs",
    "build:win": "electron-builder --win portable --x64 --publish never"
  },
  "build": {
    "appId": "local.ascci.desktop",
    "productName": "ASCIIChat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "assets/branding/**",
      "index.html",
      "style.css",
      "app.js",
      "ascii.js",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/branding/asciichat.ico",
      "signExecutable": false
    },
    "artifactName": "ASCIIChat-${version}-Windows.${ext}"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  }
}
